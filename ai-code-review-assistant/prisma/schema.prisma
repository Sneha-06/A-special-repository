generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisType {
  CODE_REVIEW
  EXPLANATION
  REFACTORING
  BUG_DETECTION
  PERFORMANCE
  SECURITY
  REACT_ANALYSIS
  ACCESSIBILITY
  UNIT_TESTS
  DOCUMENTATION
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingCategory {
  BUG
  SECURITY
  PERFORMANCE
  STYLE
  ACCESSIBILITY
  REACT
  MAINTAINABILITY
  TESTING
  DOCUMENTATION
  OTHER
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  avatarUrl    String?
  githubLogin  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  repositories Repository[]
  sessions     CodeSession[]
  codeReviews  CodeReview[]

  @@index([email])
}

model Repository {
  id            String        @id @default(uuid())
  userId        String?
  githubId      Int?          @unique
  owner         String
  name          String
  fullName      String
  description   String?
  defaultBranch String        @default("main")
  language      String?
  stars         Int           @default(0)
  isPrivate     Boolean       @default(false)
  htmlUrl       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions      CodeSession[]
  pullRequests  PullRequest[]

  @@unique([owner, name])
  @@index([userId])
}

model PullRequest {
  id           String       @id @default(uuid())
  repositoryId String
  githubId     Int
  number       Int
  title        String
  state        String
  author       String?
  baseBranch   String?
  headBranch   String?
  htmlUrl      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sessions     CodeSession[]

  @@unique([repositoryId, number])
  @@index([repositoryId])
}

model CodeSession {
  id             String         @id @default(uuid())
  userId         String?
  repositoryId   String?
  pullRequestId  String?
  title          String
  filePath       String?
  language       String         @default("typescript")
  sourceCode     String         @db.Text
  analysisType   AnalysisType
  status         AnalysisStatus @default(PROCESSING)
  model          String
  summary        String?        @db.Text
  improvedCode   String?        @db.Text
  documentation  String?        @db.Text
  unitTests      String?        @db.Text
  input          Json
  output         Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository     Repository?    @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  pullRequest    PullRequest?   @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  findings       Finding[]

  @@index([analysisType])
  @@index([status])
  @@index([createdAt])
  @@index([repositoryId])
}

model Finding {
  id          String          @id @default(uuid())
  sessionId   String
  title       String
  description String          @db.Text
  severity    FindingSeverity @default(MEDIUM)
  category    FindingCategory @default(OTHER)
  lineStart   Int?
  lineEnd     Int?
  suggestion  String?         @db.Text
  createdAt   DateTime        @default(now())
  session     CodeSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([severity])
  @@index([category])
}

model GitHubRepository {
  id            String       @id @default(uuid())
  githubId      Int?         @unique
  owner         String
  name          String
  fullName      String
  description   String?
  defaultBranch String       @default("main")
  language      String?
  htmlUrl       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  reviews       CodeReview[]

  @@unique([owner, name])
  @@map("github_repositories")
}

model CodeReview {
  id             String            @id @default(uuid())
  userId         String?
  repositoryId   String?
  fileName       String?
  language       String
  framework      String?
  reviewTypes    String[]
  overallScore   Int
  issueCount     Int               @default(0)
  criticalCount  Int               @default(0)
  highCount      Int               @default(0)
  mediumCount    Int               @default(0)
  lowCount       Int               @default(0)
  summary        String            @db.Text
  reviewResult   Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository     GitHubRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  issues         ReviewIssue[]
  history        ReviewHistory[]

  @@index([createdAt])
  @@index([repositoryId])
  @@index([overallScore])
  @@index([language])
  @@map("code_reviews")
}

model ReviewIssue {
  id          String     @id @default(uuid())
  reviewId    String
  issueId     String
  title       String
  description String     @db.Text
  severity    String
  category    String
  lineStart   Int?
  lineEnd     Int?
  suggestion  String?    @db.Text
  explanation String?    @db.Text
  createdAt   DateTime   @default(now())
  review      CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([severity])
  @@index([category])
  @@map("review_issues")
}

model ReviewHistory {
  id        String     @id @default(uuid())
  reviewId  String
  action    String     @default("created")
  metadata  Json?
  createdAt DateTime   @default(now())
  review    CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([createdAt])
  @@map("review_history")
}
